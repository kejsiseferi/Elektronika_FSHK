# GRAFIKU 1: Eksperimenti 1 - Pjestuesi i Tensionit
# ==========================================
fig, ax1 = plt.subplots(figsize=(7, 4))

parametrat_exp1 = ['V_in (Hyrja)', 'V_out (Dalja Matur)', 'V_out (Teorik)']
vlerat_exp1 = [15.35, 7.50, 7.79] # në V[cite: 2]
ngjyrat_1 = ['#2b6cb0', '#dd6b20', '#38a169']

bars1 = ax1.bar(parametrat_exp1, vlerat_exp1, color=ngjyrat_1, width=0.5)
ax1.set_ylabel('Tensioni (V)', fontsize=11, fontweight='bold')
ax1.set_title('Eksperimenti 1: Pjestuesi Baze i Tensionit', fontsize=13, fontweight='bold', pad=12)
ax1.set_ylim(0, 18)
ax1.grid(axis='y', linestyle='--', alpha=0.6)

for bar in bars1:
    yval = bar.get_height()
    ax1.text(bar.get_x() + bar.get_width()/2.0, yval + 0.4, f'{yval} V', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
# plt.savefig('../figs/eksperimenti_1.png', dpi=300)
plt.show()

