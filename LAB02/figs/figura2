# GRAFIKU 2: Eksperimenti 2 - Qarku i Hapur (Megaohm)
# ==========================================
fig, ax2 = plt.subplots(figsize=(7, 4))

komponentet_exp2 = ['R1 (MΩ)', 'R2 (MΩ)', 'V_in (V)', 'V_out (V)']
vlerat_exp2 = [3.27, 3.30, 6.82, 6.71] # Vlerat në Megaohm dhe Volt[cite: 2]
ngjyrat_2 = ['#4a5568', '#4a5568', '#2b6cb0', '#dd6b20']

bars2 = ax2.bar(komponentet_exp2, vlerat_exp2, color=ngjyrat_2, width=0.5)
ax2.set_ylabel('Vlerat (MΩ / V)', fontsize=11, fontweight='bold')
ax2.set_title('Eksperimenti 2: Qarku i Hapur me Rezistenca të Larta', fontsize=13, fontweight='bold', pad=12)
ax2.set_ylim(0, 8)
ax2.grid(axis='y', linestyle='--', alpha=0.6)

for bar in bars2:
    yval = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2.0, yval + 0.2, f'{yval}', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
# plt.savefig('../figs/eksperimenti_2.png', dpi=300)
plt.show()
