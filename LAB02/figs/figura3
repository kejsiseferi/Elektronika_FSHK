# GRAFIKU 3: Eksperimenti 3 - Qarku me Ngarkesë (RL)
# ==========================================
fig, ax3 = plt.subplots(figsize=(8, 4))

rastet_exp3 = ['Pa Ngarkesë', 'Rasti 1 (RL = 3.30 MΩ)', 'Rasti 2 (RL = 2.34 MΩ)']
tensionet_exp3 = [7.76, 7.76, 7.71] # Vlerat e matura të tensionit[cite: 2]
ngjyrat_3 = ['#3182ce', '#319795', '#d69e2e']

bars3 = ax3.bar(rastet_exp3, tensionet_exp3, color=ngjyrat_3, width=0.5)
ax3.set_ylabel('Tensioni V (V)', fontsize=11, fontweight='bold')
ax3.set_title('Eksperimenti 3: Ndikimi i Rezistencës së Ngarkesës (RL)', fontsize=13, fontweight='bold', pad=12)
ax3.set_ylim(0, 9)
ax3.grid(axis='y', linestyle='--', alpha=0.6)

for bar in bars3:
    yval = bar.get_height()
    ax3.text(bar.get_x() + bar.get_width()/2.0, yval + 0.2, f'{yval} V', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
# plt.savefig('../figs/eksperimenti_3.png', dpi=300)
plt.show()