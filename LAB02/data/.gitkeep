# Eksperimenti 1: Pjestuesi i tensionit
V_in_exp1 = 15.35  # V
V_out_exp1 = 7.50  # V
R1_exp1 = 7.55     # kOhm
R2_exp1 = 7.78     # kOhm

# Llogaritja teorike e V_out per Eksperimentin 1
V_out_teorik = V_in_exp1 * (R2_exp1 / (R1_exp1 + R2_exp1))
print(f"Eksperimenti 1 - V_out Teorik: {V_out_teorik:.2f} V (I matur: {V_out_exp1} V)")

# Eksperimenti 2: Qarku i hapur (Pa ngarkese)
